# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json

# Private local planning notes
LOCAL_WEBSITE_ROADMAP.md

# Bundler local config (gems live outside the repo)
.bundle/

# local preview override
_config_localpreview.yml

# Unpublished drafts stay local. Jekyll never renders _drafts, but the repo is
# public, so anything committed here is readable by anyone even though it 404s
# on the site. Move a file to _posts/ when it is ready to be published.
_drafts/
